# OCR用（Google Cloud Vision API）
# https://console.cloud.google.com/ → 認証情報 → APIキー作成
GOOGLE_VISION_API_KEY=AIzaSy...

# 類題生成用（Gemini / Google AI Studio）
# https://aistudio.google.com/ → Get API key（クレカ不要・無料枠あり）
GEMINI_API_KEY=AIzaSy...

# 使用モデル（任意・デフォルトは 3.1 Flash Lite Preview）
# GEMINI_MODEL=gemini-3.1-flash-lite-preview  # 推奨：速い＆品質◎（preview）
# GEMINI_MODEL=gemini-2.5-flash               # 安定版が必要なとき
# GEMINI_MODEL=gemini-2.5-pro                 # 性能最優先・遅い・1日50回
# GEMINI_MODEL=gemini-2.0-flash               # 速い・1日1500回

# Gemini混雑時の予備モデル・再試行設定（任意）
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
# GEMINI_MAX_RETRIES=1
# GEMINI_RETRY_WAIT_SECONDS=2
